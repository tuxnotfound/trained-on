#!/usr/bin/env bash
# Prints one secret for Kamal: the shell's value if set, else the value in the
# gitignored .env. Prints nothing when neither has it.
set -eu
name="$1"
value="$(printenv "$name" 2>/dev/null || true)"
if [ -z "$value" ] && [ -f .env ]; then
  value="$(grep "^${name}=" .env | head -1 | cut -d= -f2- || true)"
fi
printf '%s' "$value"
