# Read at deploy time by bin/secret: the shell's value, or the one in the
# gitignored .env. Never write a raw secret into this file.
KAMAL_REGISTRY_PASSWORD=$(bin/secret KAMAL_REGISTRY_PASSWORD)
RAILS_MASTER_KEY=$(cat config/master.key)
TRAINED_ON_ADMIN_PASSWORD=$(bin/secret TRAINED_ON_ADMIN_PASSWORD)
SMTP_PASSWORD=$(bin/secret SMTP_PASSWORD)
ANTHROPIC_API_KEY=$(bin/secret ANTHROPIC_API_KEY)
OPENAI_API_KEY=$(bin/secret OPENAI_API_KEY)
GEMINI_API_KEY=$(bin/secret GEMINI_API_KEY)
R2_ACCESS_KEY_ID=$(bin/secret R2_ACCESS_KEY_ID)
R2_SECRET_ACCESS_KEY=$(bin/secret R2_SECRET_ACCESS_KEY)
# Plain settings, here so they come from .env too; see deploy.yml.
R2_ENDPOINT=$(bin/secret R2_ENDPOINT)
R2_BUCKET=$(bin/secret R2_BUCKET)
SMTP_ADDRESS=$(bin/secret SMTP_ADDRESS)
SMTP_USERNAME=$(bin/secret SMTP_USERNAME)
TRAINED_ON_REVIEWER=$(bin/secret TRAINED_ON_REVIEWER)
TRAINED_ON_MAIL_FROM=$(bin/secret TRAINED_ON_MAIL_FROM)
