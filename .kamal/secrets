# Read at deploy time from the shell, or from the gitignored .env when the
# shell has no value. Never write a raw secret into this file.
KAMAL_REGISTRY_PASSWORD=$(printf '%s' "${KAMAL_REGISTRY_PASSWORD:-$(grep '^KAMAL_REGISTRY_PASSWORD=' .env | cut -d= -f2-)}")
RAILS_MASTER_KEY=$(cat config/master.key)
TRAINED_ON_ADMIN_PASSWORD=$(printf '%s' "${TRAINED_ON_ADMIN_PASSWORD:-$(grep '^TRAINED_ON_ADMIN_PASSWORD=' .env | cut -d= -f2-)}")
SMTP_PASSWORD=$(printf '%s' "${SMTP_PASSWORD:-$(grep '^SMTP_PASSWORD=' .env | cut -d= -f2-)}")
ANTHROPIC_API_KEY=$(printf '%s' "${ANTHROPIC_API_KEY:-$(grep '^ANTHROPIC_API_KEY=' .env | cut -d= -f2-)}")
OPENAI_API_KEY=$(printf '%s' "${OPENAI_API_KEY:-$(grep '^OPENAI_API_KEY=' .env | cut -d= -f2-)}")
GEMINI_API_KEY=$(printf '%s' "${GEMINI_API_KEY:-$(grep '^GEMINI_API_KEY=' .env | cut -d= -f2-)}")
