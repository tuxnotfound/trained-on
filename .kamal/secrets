# Secrets are read at deploy time from the shell, or from the gitignored .env
# when the shell has no value. Never write a raw secret into this file.
from_env() { v="${!1}"; [ -n "$v" ] && printf '%s' "$v" || grep "^$1=" .env 2>/dev/null | head -1 | cut -d= -f2-; }
KAMAL_REGISTRY_PASSWORD=$(from_env KAMAL_REGISTRY_PASSWORD)
RAILS_MASTER_KEY=$(cat config/master.key)
TRAINED_ON_ADMIN_PASSWORD=$(from_env TRAINED_ON_ADMIN_PASSWORD)
SMTP_PASSWORD=$(from_env SMTP_PASSWORD)
ANTHROPIC_API_KEY=$(from_env ANTHROPIC_API_KEY)
OPENAI_API_KEY=$(from_env OPENAI_API_KEY)
GEMINI_API_KEY=$(from_env GEMINI_API_KEY)
