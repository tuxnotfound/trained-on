# Local development settings. Copy to .env and fill in:  cp .env.example .env
# .env is gitignored and loaded automatically in development only.
# A value already set in your shell wins over the file.

# Review admin at /admin. Both are required: without them the admin refuses
# every request.
TRAINED_ON_ADMIN_USER=tux
TRAINED_ON_ADMIN_PASSWORD=

# The review panel: three readers, one per company. With all three keys set,
# the panel publishes changes the three agree on. With fewer, it only advises
# and every event waits for a person. Check keys and model ids with
# `bin/rails trained_on:panel_check`; override a model with the *_MODEL variable.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# TRAINED_ON_ANTHROPIC_MODEL=claude-opus-5
# TRAINED_ON_OPENAI_MODEL=gpt-5.5
# TRAINED_ON_GEMINI_MODEL=gemini-3.1-pro-preview

# Optional: where the nightly refresh emails new events, and the sender.
# TRAINED_ON_REVIEWER=
# TRAINED_ON_MAIL_FROM=

# Deploy only: a GitHub token with write:packages, so Kamal can push the image
# to ghcr.io. See README "Deploy".
# KAMAL_REGISTRY_PASSWORD=

# Deploy only: nightly SQLite backup to Cloudflare R2 (an S3 API token for the
# bucket). Same names as the other apps on the shared box.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# R2_BUCKET=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=

# Optional: a different clone of OTA's genai-contrib-versions.
# TRAINED_ON_CORPUS=corpus/genai-contrib-versions
