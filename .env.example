# Local development settings. Copy to .env and fill in:  cp .env.example .env
# .env is gitignored and loaded automatically in development only.
# A value already set in your shell wins over the file.

# Review admin at /admin. Both are required: without them the admin refuses
# every request.
TRAINED_ON_ADMIN_USER=tux
TRAINED_ON_ADMIN_PASSWORD=

# Optional: Claude Haiku's first opinion on new events in the nightly refresh.
# ANTHROPIC_API_KEY=

# Optional: where the nightly refresh emails new events, and the sender.
# TRAINED_ON_REVIEWER=
# TRAINED_ON_MAIL_FROM=

# Optional: a different clone of OTA's genai-contrib-versions.
# TRAINED_ON_CORPUS=corpus/genai-contrib-versions
