<% if @published.any? -%>
PUBLISHED BY THE PANEL (<%= @published.size %>), three readers agreed:
<% @published.each do |event| -%>
- <%= event.occurred_on %>  <%= event.vendor.name %> / <%= event.document.name %>
  <%= event.one_line %>
  <%= change_url(event) %>  (undo: <%= admin_event_url(event.id) %>)
<% end -%>

<% end -%>
<% if @rejected.any? -%>
REJECTED BY THE PANEL (<%= @rejected.size %>):
<% @rejected.each do |event| -%>
- <%= event.occurred_on %>  <%= event.vendor.name %> / <%= event.document.name %>: <%= event.panel_reason %>
<% end -%>

<% end -%>
<% if @pending.any? -%>
WAITING FOR YOU (<%= @pending.size %>):
<% @pending.each do |event| -%>
- <%= event.occurred_on %>  <%= event.vendor.name %> / <%= event.document.name %> [<%= event.kind %>]
  <%= event.panel_reason || "the panel has not run" %>
  <%= admin_event_url(event.id) %>
<% end -%>

<% end -%>
<% if @rows.any? -%>
REGISTRY ROWS NEEDING YOU (<%= @rows.size %>):
<% @rows.each do |tier| -%>
- <%= tier.vendor.name %> / <%= tier.name %>: <%= tier.verified_on ? (tier.panel_reason || "not yet checked by the panel") : "quote no longer in the latest capture; update db/seeds/tiers.yml" %>
<% end -%>

<% end -%>
<% if @unanchored.any? -%>
The net sees training language no anchor covers in: <%= @unanchored.map(&:ota_path).join(", ") %>.
<% end -%>
Nothing is published unless three readers from three companies agree.
